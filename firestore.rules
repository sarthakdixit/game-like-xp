rules_version = '2';

// Deny-by-default: Batch 1 only needs Auth wired up, no Firestore reads/writes
// yet, so there is nothing to allow. Batch 2 adds the users/{uid}/... data
// model and the real per-user-isolation rules alongside it.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
